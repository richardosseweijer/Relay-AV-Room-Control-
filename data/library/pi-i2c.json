  "transports": {
    "local": {
      "kind": "i2c",
      "bus": 1,
      "address": "0x3c",
      "timeoutMs": 1500
    }
  },
  "auth": {
    "type": "none",
    "instanceFields": [
      "address"
    ]
  },
  "helpers": {
    "checksum": "none"
  },
  "commands": [
    {
      "id": "power.on",
      "label": "Write 0x01",
      "kind": "action",
      "transport": "rs232",
      "payload": "0x00 0x01"
    }
  ],
  "feedback": []
}