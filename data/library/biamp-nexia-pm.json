{
  "specVersion": "2",
  "device": {
    "manufacturer": "Biamp",
    "model": "Nexia PM",
    "type": "mixer",
    "notes": "NTP on Telnet TCP 23 (LF after each command). Static IP — no DHCP. In Nexia software set Instance ID Tags: MicIn = 4-ch mic/line block, LineIn = 12-ch stereo line block, LineOut = 6-ch stereo out block. Device ID 1. Levels are dB (−100 to +12). Preset recall uses the compiler preset number. RS-232 default 38400 8N1, same strings. Disable telnet echo if GET replies look doubled (IAC WON'T ECHO is sent on connect)."
  },
  "transports": {
    "lan": {
      "protocol": "tcp",
      "port": 23,
      "encoding": "ascii",
      "lineEnding": "\n",
      "timeoutMs": 2500,
      "session": { "keepMs": 20000, "reply": "\u00ff\u00fe\u0001" }
    },
    "rs232": {
      "baud": 38400,
      "dataBits": 8,
      "parity": "none",
      "stopBits": 1,
      "encoding": "ascii",
      "lineEnding": "\n",
      "timeoutMs": 2000
    }
  },
  "auth": { "type": "none", "instanceFields": [] },
  "pacing": { "minIntervalMs": 80 },
  "probe": { "transport": "lan", "payload": "GET 0 IPADDR", "success": { "type": "regex", "pattern": "\\d+\\.\\d+\\.\\d+\\.\\d+" } },
  "helpers": { "checksum": "none" },
  "commands": [
    { "id": "mic.1.level.set", "label": "Mic 1 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 INPLVL MicIn 1 {value}" },
    { "id": "mic.2.level.set", "label": "Mic 2 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 INPLVL MicIn 2 {value}" },
    { "id": "mic.3.level.set", "label": "Mic 3 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 INPLVL MicIn 3 {value}" },
    { "id": "mic.4.level.set", "label": "Mic 4 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 INPLVL MicIn 4 {value}" },
    { "id": "mic.1.mute.on", "label": "Mute mic 1", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTE MicIn 1 1" },
    { "id": "mic.1.mute.off", "label": "Unmute mic 1", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTE MicIn 1 0" },
    { "id": "mic.2.mute.on", "label": "Mute mic 2", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTE MicIn 2 1" },
    { "id": "mic.2.mute.off", "label": "Unmute mic 2", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTE MicIn 2 0" },
    { "id": "mic.3.mute.on", "label": "Mute mic 3", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTE MicIn 3 1" },
    { "id": "mic.3.mute.off", "label": "Unmute mic 3", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTE MicIn 3 0" },
    { "id": "mic.4.mute.on", "label": "Mute mic 4", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTE MicIn 4 1" },
    { "id": "mic.4.mute.off", "label": "Unmute mic 4", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTE MicIn 4 0" },
    { "id": "mic.1.phantom.on", "label": "Phantom 1 on", "kind": "action", "transport": "lan", "payload": "SET 1 PHPWR MicIn 1 1" },
    { "id": "mic.1.phantom.off", "label": "Phantom 1 off", "kind": "action", "transport": "lan", "payload": "SET 1 PHPWR MicIn 1 0" },
    { "id": "mic.2.phantom.on", "label": "Phantom 2 on", "kind": "action", "transport": "lan", "payload": "SET 1 PHPWR MicIn 2 1" },
    { "id": "mic.2.phantom.off", "label": "Phantom 2 off", "kind": "action", "transport": "lan", "payload": "SET 1 PHPWR MicIn 2 0" },
    { "id": "mic.3.phantom.on", "label": "Phantom 3 on", "kind": "action", "transport": "lan", "payload": "SET 1 PHPWR MicIn 3 1" },
    { "id": "mic.3.phantom.off", "label": "Phantom 3 off", "kind": "action", "transport": "lan", "payload": "SET 1 PHPWR MicIn 3 0" },
    { "id": "mic.4.phantom.on", "label": "Phantom 4 on", "kind": "action", "transport": "lan", "payload": "SET 1 PHPWR MicIn 4 1" },
    { "id": "mic.4.phantom.off", "label": "Phantom 4 off", "kind": "action", "transport": "lan", "payload": "SET 1 PHPWR MicIn 4 0" },
    { "id": "line.1.level.set", "label": "Line 1 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 INPLVLPML LineIn 1 {value}" },
    { "id": "line.2.level.set", "label": "Line 2 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 INPLVLPML LineIn 2 {value}" },
    { "id": "line.3.level.set", "label": "Line 3 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 INPLVLPML LineIn 3 {value}" },
    { "id": "line.4.level.set", "label": "Line 4 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 INPLVLPML LineIn 4 {value}" },
    { "id": "line.5.level.set", "label": "Line 5 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 INPLVLPML LineIn 5 {value}" },
    { "id": "line.6.level.set", "label": "Line 6 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 INPLVLPML LineIn 6 {value}" },
    { "id": "line.1.mute.on", "label": "Mute line 1", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTEPML LineIn 1 1" },
    { "id": "line.1.mute.off", "label": "Unmute line 1", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTEPML LineIn 1 0" },
    { "id": "line.2.mute.on", "label": "Mute line 2", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTEPML LineIn 2 1" },
    { "id": "line.2.mute.off", "label": "Unmute line 2", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTEPML LineIn 2 0" },
    { "id": "line.3.mute.on", "label": "Mute line 3", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTEPML LineIn 3 1" },
    { "id": "line.3.mute.off", "label": "Unmute line 3", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTEPML LineIn 3 0" },
    { "id": "line.4.mute.on", "label": "Mute line 4", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTEPML LineIn 4 1" },
    { "id": "line.4.mute.off", "label": "Unmute line 4", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTEPML LineIn 4 0" },
    { "id": "line.5.mute.on", "label": "Mute line 5", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTEPML LineIn 5 1" },
    { "id": "line.5.mute.off", "label": "Unmute line 5", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTEPML LineIn 5 0" },
    { "id": "line.6.mute.on", "label": "Mute line 6", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTEPML LineIn 6 1" },
    { "id": "line.6.mute.off", "label": "Unmute line 6", "kind": "action", "transport": "lan", "payload": "SET 1 INPMUTEPML LineIn 6 0" },
    { "id": "out.1.level.set", "label": "Out 1 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 OUTLVLPM LineOut 1 {value}" },
    { "id": "out.2.level.set", "label": "Out 2 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 OUTLVLPM LineOut 2 {value}" },
    { "id": "out.3.level.set", "label": "Out 3 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 OUTLVLPM LineOut 3 {value}" },
    { "id": "out.4.level.set", "label": "Out 4 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 OUTLVLPM LineOut 4 {value}" },
    { "id": "out.5.level.set", "label": "Out 5 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 OUTLVLPM LineOut 5 {value}" },
    { "id": "out.6.level.set", "label": "Out 6 level", "kind": "range", "min": -100, "max": 12, "step": 0.5, "transport": "lan", "payload": "SET 1 OUTLVLPM LineOut 6 {value}" },
    { "id": "out.1.mute.on", "label": "Mute out 1", "kind": "action", "transport": "lan", "payload": "SET 1 OUTMUTEPM LineOut 1 1" },
    { "id": "out.1.mute.off", "label": "Unmute out 1", "kind": "action", "transport": "lan", "payload": "SET 1 OUTMUTEPM LineOut 1 0" },
    { "id": "out.2.mute.on", "label": "Mute out 2", "kind": "action", "transport": "lan", "payload": "SET 1 OUTMUTEPM LineOut 2 1" },
    { "id": "out.2.mute.off", "label": "Unmute out 2", "kind": "action", "transport": "lan", "payload": "SET 1 OUTMUTEPM LineOut 2 0" },
    { "id": "out.3.mute.on", "label": "Mute out 3", "kind": "action", "transport": "lan", "payload": "SET 1 OUTMUTEPM LineOut 3 1" },
    { "id": "out.3.mute.off", "label": "Unmute out 3", "kind": "action", "transport": "lan", "payload": "SET 1 OUTMUTEPM LineOut 3 0" },
    { "id": "out.4.mute.on", "label": "Mute out 4", "kind": "action", "transport": "lan", "payload": "SET 1 OUTMUTEPM LineOut 4 1" },
    { "id": "out.4.mute.off", "label": "Unmute out 4", "kind": "action", "transport": "lan", "payload": "SET 1 OUTMUTEPM LineOut 4 0" },
    { "id": "out.5.mute.on", "label": "Mute out 5", "kind": "action", "transport": "lan", "payload": "SET 1 OUTMUTEPM LineOut 5 1" },
    { "id": "out.5.mute.off", "label": "Unmute out 5", "kind": "action", "transport": "lan", "payload": "SET 1 OUTMUTEPM LineOut 5 0" },
    { "id": "out.6.mute.on", "label": "Mute out 6", "kind": "action", "transport": "lan", "payload": "SET 1 OUTMUTEPM LineOut 6 1" },
    { "id": "out.6.mute.off", "label": "Unmute out 6", "kind": "action", "transport": "lan", "payload": "SET 1 OUTMUTEPM LineOut 6 0" },
    { "id": "preset.recall", "label": "Recall preset", "kind": "range", "min": 1, "max": 20, "step": 1, "transport": "lan", "payload": "RECALL 0 PRESET {value}" }
  ],
  "feedback": [
    { "id": "system.ip", "label": "IP", "kind": "string", "transport": "lan", "mode": "poll", "query": "GET 0 IPADDR", "pollMs": 30000, "parse": { "type": "regex", "pattern": "(\\d+\\.\\d+\\.\\d+\\.\\d+)" } },
    { "id": "mic.1.level", "label": "Mic 1", "kind": "range", "min": -100, "max": 12, "transport": "lan", "mode": "poll", "query": "GET 1 INPLVL MicIn 1", "pollMs": 8000, "parse": { "type": "regex", "pattern": "(-?\\d+(?:\\.\\d+)?)" } },
    { "id": "mic.2.level", "label": "Mic 2", "kind": "range", "min": -100, "max": 12, "transport": "lan", "mode": "poll", "query": "GET 1 INPLVL MicIn 2", "pollMs": 8000, "parse": { "type": "regex", "pattern": "(-?\\d+(?:\\.\\d+)?)" } },
    { "id": "mic.3.level", "label": "Mic 3", "kind": "range", "min": -100, "max": 12, "transport": "lan", "mode": "poll", "query": "GET 1 INPLVL MicIn 3", "pollMs": 8000, "parse": { "type": "regex", "pattern": "(-?\\d+(?:\\.\\d+)?)" } },
    { "id": "mic.4.level", "label": "Mic 4", "kind": "range", "min": -100, "max": 12, "transport": "lan", "mode": "poll", "query": "GET 1 INPLVL MicIn 4", "pollMs": 8000, "parse": { "type": "regex", "pattern": "(-?\\d+(?:\\.\\d+)?)" } },
    { "id": "out.1.level", "label": "Out 1", "kind": "range", "min": -100, "max": 12, "transport": "lan", "mode": "poll", "query": "GET 1 OUTLVLPM LineOut 1", "pollMs": 8000, "parse": { "type": "regex", "pattern": "(-?\\d+(?:\\.\\d+)?)" } }
  ]
}
