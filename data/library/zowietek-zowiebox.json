      "id": "tally.state",
      "label": "Tally",
      "kind": "enum",
      "values": ["off", "on"],
      "transport": "lan",
      "mode": "poll",
      "httpMethod": "POST",
      "httpPath": "/system?option=getinfo&login_check_flag=1",
      "query": "{\"group\":\"tally_led\",\"opt\":\"get_tally_led_info\"}",
      "pollMs": 4000,
      "parse": {
        "type": "jsonpath",
        "path": "data.switch",
        "map": { "0": "off", "1": "on" }
      }
    },
