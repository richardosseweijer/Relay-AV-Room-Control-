{
  "specVersion": "2",
  "device": {
    "manufacturer": "Zowietek",
    "model": "ZowieBox",
    "type": "source",
    "notes": "HTTP :80 ZowieAPI (Companion POST bodies). Encoder XOR decoder. Local RTSP is always on: rtsp://IP:8554/main/av and /sub/av. NDI encode on often drops internet RTMP/SRT. Stream 0–3 are existing Internet publish slots. Record tasks: usb1_0, sdcard_0, nas1_0. Output format commands also set HDMI audio on and loop-out on (API requires all three). PTZ talks to a camera attached to the box (Visca). NDI decode needs the source name in the ndi field. Digital zoom 100–1200. No session cookie. Not a USB capture card. Encode bitrate/profile omitted — that POST replaces the whole venc array."
  },
  "transports": {
    "lan": {
      "protocol": "http",
      "port": 80,
      "timeoutMs": 3000,
      "http": {
        "method": "POST",
        "path": "/video?option=getinfo&login_check_flag=1",
        "contentType": "application/json"
      }
    }
  },
  "auth": {
    "type": "none",
    "instanceFields": ["ndi", "preset"],
    "pairing": {
      "kind": "none",
      "ports": [80],
      "discoverPath": "/",
      "userPrompt": "AV-LAN IPv4. Port 80. Optional: ndi = NDI source name for decode; preset = PTZ preset id."
    }
  },
  "pacing": {
    "minIntervalMs": 150
  },
  "probe": {
    "transport": "lan",
    "payload": "",
    "success": {
      "type": "contains",
      "value": ""
    }
  },
  "helpers": {
    "checksum": "none"
  },
