# Copy to /etc/sudoers.d/relay-kiosk (visudo -c -f first).
# Replace USER with the Relay service account (same as deploy/relay.service).
# Configurator "Start / restart panel on HDMI" restarts this unit only.
USER ALL=(root) NOPASSWD: \
  /usr/bin/systemctl start relay-kiosk.service, /usr/bin/systemctl restart relay-kiosk.service, /usr/bin/systemctl try-restart relay-kiosk.service, /usr/bin/systemctl stop relay-kiosk.service
