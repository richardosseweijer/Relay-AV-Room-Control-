# Copy to /etc/sudoers.d/relay-ufw (visudo -cf first).
# Replace USER with the Relay service account (same as deploy/relay.service User=).
# Configurator Apply AV-LAN uses: sudo -n /usr/local/sbin/relay-ufw-av-lan …
# Helper allowlists status/reload and 8081 allow/delete with comment Relay-AV-LAN only.
# Do not grant unrestricted NOPASSWD ALL. Never opens Anywhere / 0.0.0.0/0.
USER ALL=(root) NOPASSWD: /usr/local/sbin/relay-ufw-av-lan
